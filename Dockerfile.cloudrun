FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential \
      libeccodes-dev \
      libgeos-dev \
      libhdf5-dev \
      libproj-dev \
      proj-bin \
      proj-data \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt requirements-nexrad.txt requirements-cloudrun.txt ./
RUN python -m pip install --upgrade pip wheel \
    && python -m pip install --no-cache-dir -r requirements-cloudrun.txt

COPY radar_processing radar_processing
COPY scripts scripts
COPY public/data public/data
COPY cloudrun cloudrun

RUN mkdir -p /app/.radar-tmp /app/.radar-raw

CMD ["python", "scripts/run_cloud_run_live.py"]
