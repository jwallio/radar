{
  "rules": [
    {
      "allowed": {
        "origins": ["https://radar.wall.cloud"],
        "methods": ["GET", "HEAD"],
        "headers": ["Range", "If-None-Match", "If-Modified-Since"]
      },
      "exposeHeaders": [
        "ETag",
        "Content-Length",
        "Content-Range",
        "Accept-Ranges",
        "Content-Type",
        "Cache-Control"
      ],
      "maxAgeSeconds": 300
    }
  ]
}
