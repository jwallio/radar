{
  "CORSRules": [
    {
      "AllowedOrigins": ["https://radar.wall.cloud"],
      "AllowedMethods": ["GET", "HEAD"],
      "AllowedHeaders": ["*"],
      "ExposeHeaders": [
        "ETag",
        "Content-Length",
        "Content-Range",
        "Accept-Ranges",
        "Content-Type",
        "Cache-Control"
      ],
      "MaxAgeSeconds": 300
    }
  ]
}
