# Cloudflare R2 S3-compatible endpoint and least-privilege worker credentials.
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=wallcloud-radar-data
R2_ACCESS_KEY_ID=replace-with-r2-object-read-write-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret
R2_OBJECT_PREFIX=
R2_RETAIN_DAYS=3

# Protected Cloudflare Worker control endpoint. The worker fails closed when
# this endpoint is configured but unavailable, preventing surprise ingestion.
RADAR_CONTROL_STATUS_URL=https://control.radar.wall.cloud/control/status
RADAR_CONTROL_TIMEOUT_SECONDS=10

# Processing limits. Keep these conservative on a 2 GB VPS.
MRMS_MAX_FRAMES=18
MRMS_RETENTION_MINUTES=90
MRMS_INCLUDE_PRECIP_TYPE=true
NEXRAD_MAX_FRAMES=12
NEXRAD_RETENTION_MINUTES=90
NEXRAD_IMAGE_WIDTH=2400
NEXRAD_TIMEOUT_SECONDS=60
NEXRAD_RETRIES=3

# Optional explicit lock location.
RADAR_WORKER_LOCK_PATH=/var/lib/wallcloud-radar/refresh.lock
